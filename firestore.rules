rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: analyses
    // Document ID: auto-generated
    // Fields:
    //   - userId: string (required) - UID of the owner
    //   - fileName: string (optional) - Name of the file
    //   - predictedRole: string (required)
    //   - resumeScore: number (required)
    //   - summary: string (required)
    //   - improvements: list (required)
    //   - recommendations: list (required)
    //   - createdAt: timestamp (required)
    //
    // ===============================================================

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidAnalysis(data) {
      return data.userId is string &&
             data.predictedRole is string &&
             data.resumeScore is number &&
             data.summary is string &&
             data.improvements is list &&
             data.recommendations is list &&
             data.createdAt is timestamp;
    }

    match /analyses/{analysisId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId) && isValidAnalysis(request.resource.data);
      allow delete: if isOwner(resource.data.userId);
      // No update allowed for analyses to maintain history integrity
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}
